rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function staffPath(uid) { return /databases/$(database)/documents/staff/$(uid); }
    function staffData() { return get(staffPath(request.auth.uid)).data; }
    function staff() { return signed() && exists(staffPath(request.auth.uid)) && staffData().active == true && staffData().role in ['owner', 'admin', 'staff']; }
    function manager() { return staff() && staffData().role in ['owner', 'admin']; }
    function owner() { return staff() && staffData().role == 'owner'; }
    function blockedCustomer(uid) { return exists(/databases/$(database)/documents/blockedCustomers/$(uid)); }
    function customer() { return signed() && request.auth.token.firebase.sign_in_provider == 'anonymous' && !blockedCustomer(request.auth.uid); }
    function canReadConversation(data) { return manager() || (staff() && data.assignedStaffUid == request.auth.uid) || (customer() && data.customerUid == request.auth.uid); }
    function canHandle(data) { return manager() || (staff() && data.assignedStaffUid == request.auth.uid); }
    function validProduct(p) { return p is map && p.keys().hasOnly(['id','name','brand','price','image','url','size','stock']) && p.id is string && p.id.size() >= 2 && p.id.size() <= 20 && p.name is string && p.name.size() <= 120 && p.brand is string && p.brand.size() <= 80 && (p.price == null || (p.price is number && p.price >= 0 && p.price <= 1000000000)) && p.image is string && p.image.size() <= 300 && (p.image == '' || p.image.matches('^/images/[A-Za-z0-9._-]+$')) && p.url is string && p.url.matches('^https://graceful-gifts-manila\\.web\\.app/watch/[A-Za-z0-9-]+$') && p.get('size', '') is string && p.get('size', '').size() <= 40 && (p.get('stock', null) == null || (p.stock is int && p.stock >= 0 && p.stock <= 1000000)); }
    function validProducts(p) { return p is list && p.size() <= 8 && (p.size() < 1 || validProduct(p[0])) && (p.size() < 2 || validProduct(p[1])) && (p.size() < 3 || validProduct(p[2])) && (p.size() < 4 || validProduct(p[3])) && (p.size() < 5 || validProduct(p[4])) && (p.size() < 6 || validProduct(p[5])) && (p.size() < 7 || validProduct(p[6])) && (p.size() < 8 || validProduct(p[7])); }
    function validMedia(m, conversationId, messageId) { return m is map && m.keys().hasAll(['kind','contentType','size','path']) && m.keys().hasOnly(['kind','contentType','size','path']) && m.path == 'chatMedia/' + conversationId + '/' + messageId + '/file' && m.size is int && m.size > 0 && ((m.kind == 'photo' && m.contentType in ['image/jpeg','image/png','image/webp','image/gif'] && m.size <= 8000000) || (m.kind == 'video' && m.contentType in ['video/mp4','video/webm','video/quicktime'] && m.size <= 30000000)); }
    function validMessageLink(id, data) { return data.lastMessageId is string && data.lastMessageId.size() == 20 && getAfter(/databases/$(database)/documents/conversations/$(id)/messages/$(data.lastMessageId)).data.message == data.lastMessage; }
    function validSummary(id, data) { return data.lastMessage is string && data.lastMessage.size() > 0 && data.lastMessage.size() <= 2000 && data.lastMessageAt == request.time && data.updatedAt == request.time && data.lastSenderUid == request.auth.uid && validMessageLink(id, data); }
    function validAuditLink(id, action, oldValue, newValue) { return request.resource.data.lastAuditId is string && request.resource.data.lastAuditId.size() == 20 && getAfter(/databases/$(database)/documents/auditLogs/$(request.resource.data.lastAuditId)).data == { 'action': action, 'conversationId': id, 'actorUid': request.auth.uid, 'oldValue': oldValue, 'newValue': newValue, 'createdAt': request.time }; }
    function conversationFor(id) { return get(/databases/$(database)/documents/conversations/$(id)).data; }
    function messageFor(id, mid) { return get(/databases/$(database)/documents/conversations/$(id)/messages/$(mid)).data; }
    function mayAcknowledge(id, mid) {
      return signed() && messageFor(id, mid).senderUid != request.auth.uid &&
        ((customer() && conversationFor(id).customerUid == request.auth.uid && messageFor(id, mid).senderRole != 'customer') ||
        (messageFor(id, mid).senderRole == 'customer' && canHandle(conversationFor(id))));
    }
    function latestSeen(id) { return get(/databases/$(database)/documents/conversations/$(id)/receipts/$(resource.data.lastMessageId)).data.seenAt != null; }

    match /conversations/{conversationId} {
      allow get: if customer() && conversationId == request.auth.uid || signed() && resource != null && canReadConversation(resource.data);
      allow list: if signed() && canReadConversation(resource.data);
      allow create: if customer() && conversationId == request.auth.uid && request.resource.data.keys().hasOnly(['customerUid','customerName','customerContact','assignedStaffUid','status','createdAt','customerReadAt','staffReadAt','productReferences','lastMessage','lastMessageAt','lastMessageId','lastSenderUid','lastSenderRole','updatedAt']) && request.resource.data.customerUid == request.auth.uid && request.resource.data.customerName is string && request.resource.data.customerName.size() <= 80 && request.resource.data.customerContact is string && request.resource.data.customerContact.size() <= 120 && request.resource.data.assignedStaffUid == null && request.resource.data.status == 'new' && request.resource.data.createdAt == request.time && request.resource.data.customerReadAt == request.time && request.resource.data.staffReadAt == null && request.resource.data.lastSenderRole == 'customer' && validProducts(request.resource.data.productReferences) && validSummary(conversationId, request.resource.data);
      allow update: if signed() && (
        (customer() && resource.data.customerUid == request.auth.uid && resource.data.lastSenderRole != 'customer' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerReadAt']) && request.resource.data.customerReadAt == request.time && latestSeen(conversationId)) ||
        (customer() && resource.data.customerUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastMessageAt','lastMessageId','lastSenderUid','lastSenderRole','updatedAt','customerReadAt','productReferences']) && request.resource.data.lastMessageId != resource.data.lastMessageId && request.resource.data.lastSenderRole == 'customer' && request.resource.data.customerReadAt == request.time && validProducts(request.resource.data.productReferences) && (resource.data.lastMessageAt + duration.value(3, 's') <= request.time) && validSummary(conversationId, request.resource.data)) ||
        (canHandle(resource.data) && resource.data.lastSenderRole == 'customer' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['staffReadAt']) && request.resource.data.staffReadAt == request.time && latestSeen(conversationId)) ||
        (canHandle(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastMessageAt','lastMessageId','lastSenderUid','lastSenderRole','updatedAt','staffReadAt']) && request.resource.data.lastMessageId != resource.data.lastMessageId && request.resource.data.lastSenderRole == staffData().role && request.resource.data.staffReadAt == request.time && validSummary(conversationId, request.resource.data)) ||
        (resource.data.lastSenderUid == request.auth.uid && ((customer() && resource.data.customerUid == request.auth.uid) || canHandle(resource.data)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt']) && request.resource.data.lastMessage != resource.data.lastMessage && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() > 0 && request.resource.data.lastMessage.size() <= 2000 && request.resource.data.updatedAt == request.time && getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(resource.data.lastMessageId)).data.message == request.resource.data.lastMessage && getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(resource.data.lastMessageId)).data.editedAt == request.time) ||
        (resource.data.lastSenderUid == request.auth.uid && ((customer() && resource.data.customerUid == request.auth.uid) || canHandle(resource.data)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt']) && request.resource.data.lastMessage == 'Message unsent' && request.resource.data.updatedAt == request.time && getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(resource.data.lastMessageId)).data.message == 'Message unsent' && getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(resource.data.lastMessageId)).data.unsentAt == request.time) ||
        (canHandle(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','lastAuditId']) && request.resource.data.status in ['new','open','pending','resolved'] && request.resource.data.status != resource.data.status && request.resource.data.updatedAt == request.time && validAuditLink(conversationId, 'status', resource.data.status, request.resource.data.status)) ||
        (manager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedStaffUid','updatedAt','lastAuditId']) && request.resource.data.assignedStaffUid != resource.data.assignedStaffUid && request.resource.data.updatedAt == request.time && validAuditLink(conversationId, 'assignment', resource.data.assignedStaffUid, request.resource.data.assignedStaffUid) && (request.resource.data.assignedStaffUid == null || (exists(staffPath(request.resource.data.assignedStaffUid)) && get(staffPath(request.resource.data.assignedStaffUid)).data.active == true && get(staffPath(request.resource.data.assignedStaffUid)).data.role in ['staff','admin'])))
      );
      allow delete: if owner();
      match /messages/{messageId} {
        allow get, list: if signed() && canReadConversation(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if signed() && !blockedCustomer(conversationId) && request.resource.data.keys().hasOnly(['senderUid','senderRole','message','createdAt','productReferences','media']) && request.resource.data.senderUid == request.auth.uid && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000 && (!('media' in request.resource.data) || validMedia(request.resource.data.media, conversationId, messageId)) && request.resource.data.createdAt == request.time && validProducts(request.resource.data.productReferences) && (customer() && request.resource.data.senderRole == 'customer' && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.customerUid == request.auth.uid || canHandle(get(/databases/$(database)/documents/conversations/$(conversationId)).data) && request.resource.data.senderRole == staffData().role) && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.lastMessageId == messageId && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.lastMessage == request.resource.data.message && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.lastMessageAt == request.time;
        allow update: if signed() && !blockedCustomer(conversationId) && resource.data.senderUid == request.auth.uid && !('unsentAt' in resource.data) && ((resource.data.senderRole == 'customer' && customer() && conversationFor(conversationId).customerUid == request.auth.uid) || (resource.data.senderRole in ['owner','admin','staff'] && canHandle(conversationFor(conversationId)))) && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message','editedAt']) && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000 && request.resource.data.message != resource.data.message && request.resource.data.editedAt == request.time && (conversationFor(conversationId).lastMessageId != messageId || (getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.lastMessage == request.resource.data.message && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.updatedAt == request.time))) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message','productReferences','media','unsentAt']) && request.resource.data.message == 'Message unsent' && request.resource.data.productReferences == [] && !('media' in request.resource.data) && request.resource.data.unsentAt == request.time && (conversationFor(conversationId).lastMessageId != messageId || (getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.lastMessage == 'Message unsent' && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.updatedAt == request.time))));
        allow delete: if owner();
      }
      match /receipts/{messageId} {
        allow get, list: if signed() && canReadConversation(conversationFor(conversationId));
        allow create: if messageId.matches('^[A-Za-z0-9]{20}$') && mayAcknowledge(conversationId, messageId) && request.resource.data.keys().hasOnly(['recipientUid','deliveredAt','seenAt','seenByUid']) && request.resource.data.recipientUid == request.auth.uid && request.resource.data.deliveredAt == request.time && (request.resource.data.get('seenAt', null) == null && request.resource.data.get('seenByUid', null) == null || request.resource.data.seenAt == request.time && request.resource.data.seenByUid == request.auth.uid);
        allow update: if mayAcknowledge(conversationId, messageId) && resource.data.get('seenAt', null) == null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt','seenByUid']) && request.resource.data.seenAt == request.time && request.resource.data.seenByUid == request.auth.uid;
        allow delete: if owner();
      }
    }
    match /blockedCustomers/{customerUid} {
      allow get: if manager() || (staff() && exists(/databases/$(database)/documents/conversations/$(customerUid)) && canHandle(conversationFor(customerUid)));
      allow list: if false;
      allow create: if manager() && exists(/databases/$(database)/documents/conversations/$(customerUid)) && conversationFor(customerUid).customerUid == customerUid && request.resource.data.keys().hasOnly(['blockedAt','blockedBy']) && request.resource.data.keys().hasAll(['blockedAt','blockedBy']) && request.resource.data.blockedAt == request.time && request.resource.data.blockedBy == request.auth.uid;
      allow update: if false;
      allow delete: if manager();
    }
    match /staff/{uid} {
      allow get, list: if staff();
      allow create: if owner() && uid != request.auth.uid && request.resource.data.keys().hasOnly(['displayName','email','role','active','createdAt','createdBy']) && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 80 && request.resource.data.email is string && request.resource.data.email.size() <= 254 && request.resource.data.role in ['admin','staff'] && request.resource.data.active == true && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if owner() && uid != request.auth.uid && resource.data.role != 'owner' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','email','role','active']) && request.resource.data.role in ['admin','staff'] && request.resource.data.active is bool && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 80 && request.resource.data.email is string && request.resource.data.email.size() <= 254;
      allow delete: if false;
      match /pushTokens/{tokenId} {
        allow get, list: if staff() && request.auth.uid == uid;
        allow create: if staff() && request.auth.uid == uid && tokenId.matches('^[a-f0-9]{40}$') && request.resource.data.keys().hasOnly(['token','createdAt','updatedAt']) && request.resource.data.token is string && request.resource.data.token.size() >= 40 && request.resource.data.token.size() <= 512 && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if false;
        allow delete: if signed() && request.auth.uid == uid;
      }
    }
    match /auditLogs/{auditId} {
      allow get, list: if owner();
      allow create: if (staff() && request.resource.data.keys().hasOnly(['action','conversationId','actorUid','oldValue','newValue','createdAt']) && request.resource.data.actorUid == request.auth.uid && request.resource.data.action in ['status','assignment'] && request.resource.data.createdAt == request.time && request.resource.data.conversationId is string && request.resource.data.conversationId.size() <= 128 && getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.lastAuditId == auditId && getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.updatedAt == request.time && (request.resource.data.action == 'assignment' && manager() || request.resource.data.action == 'status' && canHandle(get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data))) ||
        (manager() && request.resource.data.keys().hasOnly(['action','conversationId','actorUid','createdAt']) && request.resource.data.keys().hasAll(['action','conversationId','actorUid','createdAt']) && request.resource.data.action in ['block','unblock'] && request.resource.data.actorUid == request.auth.uid && request.resource.data.conversationId is string && request.resource.data.conversationId.size() <= 128 && request.resource.data.createdAt == request.time && (request.resource.data.action == 'block' && !exists(/databases/$(database)/documents/blockedCustomers/$(request.resource.data.conversationId)) && existsAfter(/databases/$(database)/documents/blockedCustomers/$(request.resource.data.conversationId)) || request.resource.data.action == 'unblock' && exists(/databases/$(database)/documents/blockedCustomers/$(request.resource.data.conversationId)) && !existsAfter(/databases/$(database)/documents/blockedCustomers/$(request.resource.data.conversationId)))) ||
        (owner() && request.resource.data.keys().hasOnly(['action','conversationId','actorUid','createdAt']) && request.resource.data.keys().hasAll(['action','conversationId','actorUid','createdAt']) && request.resource.data.action == 'delete' && request.resource.data.actorUid == request.auth.uid && request.resource.data.conversationId is string && request.resource.data.conversationId.size() <= 128 && request.resource.data.createdAt == request.time && exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)) && !existsAfter(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)));
      allow update, delete: if false;
    }
    match /settings/{settingId} {
      allow get: if settingId == 'chat' && (staff() || customer());
      allow list: if false;
      allow create, update: if settingId == 'chat' && owner() && request.resource.data.keys().hasOnly(['staffSoundEnabled','storeAvatarUrl','updatedAt']) && request.resource.data.staffSoundEnabled is bool && request.resource.data.get('storeAvatarUrl', '') is string && (request.resource.data.get('storeAvatarUrl', '') == '' || request.resource.data.storeAvatarUrl.matches('^/images/[A-Za-z0-9._-]+$')) && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
